@page "/decks"
@using MagicDraftStats.Models
@using MagicDraftStats.Services
@inject IDeckTableDataService DeckTableDataService

<PageTitle>Magic Draft Stats - Decks</PageTitle>

<div class="container mt-2 mt-md-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <h1><i class="bi bi-stack me-4 d-none d-md-inline"></i>Decks</h1>
        <div class="text-muted mt-1 mt-md-0">
            @if (!isLoading)
            {
                <span>Showing @filteredDeckRows.Count of @deckRows.Count decks</span>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            <i class="bi bi-arrow-clockwise spin me-2"></i>Loading deck data...
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i>@errorMessage
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header">
                <button class="btn btn-link text-decoration-none p-0 w-100 d-flex align-items-center justify-content-between fw-semibold collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#decksFiltersCollapse"
                        aria-expanded="false"
                        aria-controls="decksFiltersCollapse">
                    <span><i class="bi bi-funnel me-2"></i>Filters</span>
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
            <div id="decksFiltersCollapse" class="collapse">
                <div class="card-body">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-5 col-sm-12">
                            <div class="d-flex flex-column gap-1">
                                <span class="fw-bold text-muted small">Filter by Rank</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var rank in uniqueRanks)
                                    {
                                        var isSelected = selectedRanks.Contains(rank);
                                        <button type="button" 
                                                class="btn btn-sm rounded-pill px-3 @(isSelected ? "btn-primary" : "btn-outline-secondary")" 
                                                @onclick="() => ToggleRank(rank)">
                                            @rank
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-7 col-sm-12">
                            <div class="d-flex flex-column gap-1">
                                <span class="fw-bold text-muted small">Filter by Players</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var count in uniquePlayerCounts)
                                    {
                                        var isSelected = selectedPlayerCounts.Contains(count);
                                        <button type="button" 
                                                class="btn btn-sm rounded-pill px-3 @(isSelected ? "btn-primary" : "btn-outline-secondary")" 
                                                @onclick="() => TogglePlayerCount(count)">
                                            @count Players
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12 col-md-3">
                            <button class="btn btn-secondary w-100" @onclick="ClearFilters" disabled="@IsFiltersDefault">
                                <i class="bi bi-arrow-clockwise me-1"></i>Reset Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!filteredDeckRows.Any())
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>No decks match the selected filters.
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <DecksTable DeckRows="filteredDeckRows" />
                </div>
            </div>
        }
    }

    @if (!isLoading && validationIssues.Any())
    {
        <div class="card mt-4 border-warning">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Deck Validation Problems
                    <span class="text-muted ms-2">(@validationIssues.Count)</span>
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Severity</th>
                                <th>File</th>
                                <th>Code</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in validationIssues)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @(issue.Severity == DeckValidationSeverity.Error ? "bg-danger" : "bg-warning text-dark")">@issue.Severity</span>
                                    </td>
                                    <td style="white-space: nowrap;">@issue.FilePath</td>
                                    <td><code>@issue.Code</code></td>
                                    <td>@issue.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<DeckTableRow> deckRows = new();
    private List<DeckTableRow> filteredDeckRows = new();
    private List<DeckValidationIssue> validationIssues = new();

    // Unique values from the dataset
    private List<int> uniqueRanks = new();
    private List<int> uniquePlayerCounts = new();

    // Active filters
    private HashSet<int> selectedRanks = new();
    private HashSet<int> selectedPlayerCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDecks();
    }

    private async Task LoadDecks()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            validationIssues = new();

            var tableData = await DeckTableDataService.LoadAsync();
            deckRows = tableData.DeckRows.ToList();
            validationIssues = tableData.ValidationIssues.ToList();

            // Find all unique values in the loaded dataset
            uniqueRanks = deckRows.Select(d => d.Rank).Distinct().OrderBy(r => r).ToList();
            uniquePlayerCounts = deckRows.Select(d => d.PlayerCount).Distinct().OrderBy(p => p).ToList();

            selectedRanks.Clear();
            selectedPlayerCounts.Clear();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading deck data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleRank(int rank)
    {
        if (selectedRanks.Contains(rank))
        {
            selectedRanks.Remove(rank);
        }
        else
        {
            selectedRanks.Add(rank);
        }

        ApplyFilters();
    }

    private void TogglePlayerCount(int playerCount)
    {
        if (selectedPlayerCounts.Contains(playerCount))
        {
            selectedPlayerCounts.Remove(playerCount);
        }
        else
        {
            selectedPlayerCounts.Add(playerCount);
        }
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = deckRows.AsEnumerable();

        if (selectedRanks.Any())
        {
            query = query.Where(d => selectedRanks.Contains(d.Rank));
        }

        if (selectedPlayerCounts.Any())
        {
            query = query.Where(d => selectedPlayerCounts.Contains(d.PlayerCount));
        }

        filteredDeckRows = query.ToList();
    }

    private bool IsFiltersDefault => selectedRanks.Count == 0 && selectedPlayerCounts.Count == 0;

    private void ClearFilters()
    {
        selectedRanks.Clear();
        selectedPlayerCounts.Clear();
        ApplyFilters();
    }
}
